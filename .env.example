# ==========================================================
# My Auth Go — contoh konfigurasi
# Salin menjadi .env untuk pengembangan lokal:
#   cp .env.example .env
# Di produksi JANGAN pakai .env — pakai EnvironmentFile systemd
# (lihat README). File .env tidak pernah masuk git.
# ==========================================================

APP_NAME=my-auth-go
APP_ENV=development
PORT=8081

# ---- Database (MariaDB / MySQL) ----
DB_USER=myauth
DB_PASSWORD=GantiDenganPasswordKuat
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=go_auth_db
DB_TLS=false

# ---- JWT ----
# WAJIB minimal 32 karakter acak. Buat dengan:
#   openssl rand -base64 48
JWT_SECRET=GantiDenganStringAcakMinimal32KarakterPanjangSekali
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# ---- Admin pertama (seeder) ----
# Seeder membuat akun ini HANYA bila belum ada admin sama sekali.
# Password minimal 12 karakter, wajib ada huruf besar/kecil/angka/simbol.
# Kosongkan ADMIN_PASSWORD untuk melewati seeder.
ADMIN_EMAIL=pudin@gmail.com
ADMIN_PASSWORD=Admin#4321GantiIni
ADMIN_NAME=Pudin Saepudin
ADMIN_NO_HP=08123456789

# ---- API ----
VERSI_API=1.0
PUBLIC_BASE_URL=http://localhost:8081

# ---- Keamanan ----
# Proxy yang dipercaya untuk header X-Forwarded-For (pisahkan dengan koma).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Origin browser yang boleh memanggil API. Kosong = CORS mati (server-to-server).
CORS_ALLOWED_ORIGINS=
# Batas percobaan endpoint auth per IP per menit.
LOGIN_RATE_LIMIT=10
# Ukuran maksimal body request (MB).
MAX_BODY_MB=2
# Cookie Secure — biarkan true bila di belakang HTTPS.
COOKIE_SECURE=true
